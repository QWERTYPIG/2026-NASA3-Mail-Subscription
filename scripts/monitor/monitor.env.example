# MailSub monitor configuration (host-level daemon)
# Copy to /etc/mailsub/monitor.env and adjust per host.

# This machine identity (required)
THIS_MACHINE_IP=172.16.127.102
THIS_MACHINE_NAME=mail1

# Peer list (comma-separated). If omitted, defaults to DB_REPLICA_HOSTS.
MONITOR_PEERS=172.16.127.102,172.16.127.116,172.16.127.117

# DB sync inputs live in /opt/mailsub/.env (loaded inside the worker container).

# Monitor loop settings
MONITOR_PORT=9123
CHECK_INTERVAL=15
FAIL_THRESHOLD=3
RECOVER_THRESHOLD=2
DEGRADED_THRESHOLD=8
SYNC_INTERVAL=600

# Paths (required)
COMPOSE_FILE=/opt/mailsub/docker-compose.yml
ENV_BASE=/opt/mailsub/.env
ENV_ROLE=/opt/mailsub/.env.role
LAST_SYNC_FILE=/var/lib/mailsub/last_sync # must be same as that in .env.role

# Optional overrides
PG_PORT=5432
REDIS_PORT=6379
TCP_TIMEOUT=2.0
HEALTH_TIMEOUT=2.0
LOG_LEVEL=INFO
